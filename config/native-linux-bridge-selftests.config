# Preserve original routed bridge/PVID behavior in the resident kernel.
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
# Run original bridge multicast packet tests with real ingress flower counters.
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_ACT_GACT=y
