# Preserve original routed bridge/PVID behavior in the resident kernel.
CONFIG_IP_ROUTE_MULTIPATH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_VLAN_FILTERING=y
# Run original bridge multicast packet tests with real ingress flower counters.
CONFIG_NET_CLS_ACT=y
CONFIG_NET_SCH_INGRESS=y
CONFIG_NET_CLS_FLOWER=y
CONFIG_NET_ACT_GACT=y

# Original locked-port/MAB redirect uses Linux mirred rather than a userspace substitute.
CONFIG_NET_ACT_MIRRED=y

# Original IPv6 VRF ingress accounting uses a real forward XFRM block policy.
CONFIG_XFRM_USER=y

# The complete original MDB dump entry creates real dummy bridge ports.
CONFIG_DUMMY=y
