        "docs/fstack-zc-contracts.md",
        "tests/upstream/fstack/tests/unit/test_ff_config_pa.c",
        "docs/fstack-page-array-contracts.md"
      ],
      "acceptance": [
        "Confirm each listed assertion is FreeBSD-internal and document the supported Linux timer/readiness behavior with existing runnable evidence.",
        "Do not transplant FreeBSD internals or declare their tests passed on unrelated Linux behavior.",
        "Retain pinned source provenance and an explicit architecture-specific disposition."
      ],
