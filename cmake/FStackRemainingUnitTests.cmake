    target_compile_options(ker-fstack-pool-test PRIVATE $<$<C_COMPILER_ID:GNU>:-Wno-format-truncation>)
    find_library(ker_pool_vdev_bus NAMES rte_bus_vdev HINTS ${DPDK_LIBRARY_DIRS} NO_DEFAULT_PATH REQUIRED)
    target_link_libraries(ker-fstack-pool-pipeline-test PRIVATE ker::pools ker::ipc "${KER_NET_RING_PMD}" "${ker_pool_vdev_bus}")
    foreach(target ker-fstack-pool-test ker-fstack-pool-pipeline-test)
        target_link_options(${target} PRIVATE -Wl,--disable-new-dtags)
        target_compile_options(${target} PRIVATE -Wall -Wextra -Werror)
        set_target_properties(${target} PROPERTIES BUILD_RPATH "${DPDK_LIBRARY_DIRS}")
    endforeach()
    add_test(NAME fstack-pool-generation COMMAND ker-fstack-pool-test generation)
    add_test(NAME fstack-pool-cache COMMAND ker-fstack-pool-test cache)
    add_test(NAME fstack-pool-legacy-consumer COMMAND "${Python3_EXECUTABLE}"
        "${CMAKE_CURRENT_SOURCE_DIR}/posix/pool-legacy.py" "$<TARGET_FILE:ker-fstack-pool-pipeline-test>")
    add_test(NAME fstack-pool-import COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/pool-import.py")
    set_tests_properties(fstack-pool-generation fstack-pool-cache fstack-pool-legacy-consumer PROPERTIES TIMEOUT 25 LABELS fstack)
    set_tests_properties(fstack-pool-import PROPERTIES TIMEOUT 15 LABELS provenance)
